<mxfile host="Electron" agent="OpenAI" pages="4">
  <diagram id="nOvJ9j9FqO1YoOz0RInE" name="数据库接入后，RPC 服务还能跑多快">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="数据库接入后，RPC 服务还能跑多快" vertex="1">
          <mxGeometry height="680" width="1070" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-5" edge="1" parent="Is3ebNiEPEQF1mh9O5qe-1" source="Is3ebNiEPEQF1mh9O5qe-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Is3ebNiEPEQF1mh9O5qe-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-7" edge="1" parent="Is3ebNiEPEQF1mh9O5qe-1" source="Is3ebNiEPEQF1mh9O5qe-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Is3ebNiEPEQF1mh9O5qe-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-2" parent="Is3ebNiEPEQF1mh9O5qe-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;数据库接入后的性能探索&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;从纯 RPC 服务到数据库读写链路，&lt;/div&gt;&lt;div&gt;研究数据库接入后服务端的真实性能变化。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;核心问题：&lt;/div&gt;&lt;div&gt;数据库接入后，RPC 服务还能跑多快？&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="270" x="100" y="232" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-4" parent="Is3ebNiEPEQF1mh9O5qe-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;数据库读写吞吐量（QPS)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;READ、INSERT、UPDATE、DELETE 四种操作分别能达到多少 QPS？&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;不同数据库操作之间的性能差异有多大？&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;相比纯 RPC 服务，接入数据库后吞吐量下降了多少？&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="375" x="543" y="120" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-6" parent="Is3ebNiEPEQF1mh9O5qe-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;请求延迟与长尾分析&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;一次数据库请求从发出到返回需要多长时间？&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;平均延迟、P50、P95、P99、P999 分别是多少？&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;高并发下，为什么部分请求会出现明显的长尾延迟？&lt;/div&gt;" vertex="1">
          <mxGeometry height="103" width="375" x="543" y="335" as="geometry" />
        </mxCell>
        <mxCell id="Is3ebNiEPEQF1mh9O5qe-11" parent="Is3ebNiEPEQF1mh9O5qe-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p&gt;&lt;strong&gt;研究背景&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;此前纯 RPC 服务端测试中，Window = 512 时，QPS 约为 200 万。&lt;/p&gt;&lt;p&gt;但接入数据库后的真实性能尚不明确。&lt;/p&gt;&lt;p&gt;因此通过四种基本数据库操作进行实际测试，建立性能基线。&lt;/p&gt;&lt;p&gt;不预设优化目标，通过实验发现问题。&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="65" y="370" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ARm5a4vaEL-gu7-OrG_p" name="数据库选型与实验方案设计">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4w2NPqUuCC1P224UtZL3-1" parent="1" style="swimlane;html=1;startSize=70;fillColor=#fafafa;strokeColor=#888888;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;" value="数据库选型与实验方案设计&lt;div&gt;&lt;p&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;从数据库技术选型出发，确定 PostgreSQL 作为本阶段的数据库，设计四种 CRUD 压测数据表，并制定测试流程与并发参数。&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="2160" width="4570" x="70" y="110" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-7" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-9" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-11" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-2" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;数据库选型：从 MySQL 转向 PostgreSQL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;原有 MySQL/MariaDB 客户端接口无法满足单连接多请求在途的架构需求。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;为了实现数据库非阻塞操作和单连接 Pipeline，重新选择数据库及其 C++ 客户端接口。&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="410" x="160" y="940" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-5" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p&gt;&lt;strong&gt;选型依据&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;我们选择 PostgreSQL，不是因为已经证明它的 QPS 一定高于 MySQL。&lt;/p&gt;&lt;p&gt;而是因为它的官方客户端接口更符合我们的目标：&lt;/p&gt;&lt;p&gt;单连接、非阻塞、多请求在途、Pipeline。&lt;/p&gt;&lt;p&gt;后续通过实际测试验证这种架构能达到什么性能。&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="380" x="175" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-13" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-6" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;MySQL / MariaDB 的连接限制&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;传统 MySQL 协议下，同一连接不能同时执行多个独立查询。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;即使使用非阻塞 API，也不能直接突破单连接一次只能执行一个查询的限制。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;增加连接数量虽然可以提高并发能力，但无法实现我们想要的单连接多请求在途。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="775" y="750" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-14" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-8" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;MySQL X Protocol 的取舍&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;X Protocol 提供了不同于传统 MySQL 协议的通信方式。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;但当时评估的官方 C++ X DevAPI 尚未提供所需的异步执行接口。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;如果继续使用，就无法直接满足当前的协程和事件循环架构目标。&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="775" y="930" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-15" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-10" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;PostgreSQL + libpq&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;PostgreSQL 官方 C 客户端库 libpq 提供：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. 非阻塞连接与查询接口。&lt;/div&gt;&lt;div&gt;2. Pipeline Mode，支持单连接连续发送多个查询。&lt;/div&gt;&lt;div&gt;3. 通过结果队列按顺序获取对应的执行结果。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;不需要自己解析数据库协议，也不需要自行实现数据库驱动。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="400" x="775" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-18" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-21" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-25" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-12" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;压测数据模型设计&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;为了测试数据库基本读写操作，设计四张结构相同、用途独立的压测数据表。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通过分别执行 READ、INSERT、UPDATE、DELETE，观察不同数据库操作的性能表现。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;核心问题：&lt;/div&gt;&lt;div&gt;如何设计一套能够公平测试四种数据库操作的数据模型？&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="430" x="1400" y="920" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-16" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;&lt;b&gt;设计目的&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;四张表相互独立，每种操作使用自己的数据集。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;这样可以分别观察不同 CRUD 操作的性能，避免不同操作直接争用同一张测试表。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;这些表仅用于性能测试，不代表真实业务数据库设计。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;当前没有用户表、订单表、商品表，也没有外键关系。&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="370" x="1430" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-27" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-17" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;统一的数据表结构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;四张表采用相同的字段设计：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;id：BIGINT，主键，必须大于 0。&lt;/div&gt;&lt;div&gt;value：BIGINT，不能为空，必须大于等于 0。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;id 用于定位记录，value 用于存储和修改数据。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通过统一字段结构，减少数据模型差异对测试结果的影响。&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="2080" y="425" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-28" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-19" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;四张独立的压测数据表&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. bench_read_records&lt;/div&gt;&lt;div&gt;专门测试按 ID 查询记录。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. bench_insert_records&lt;/div&gt;&lt;div&gt;专门测试新增记录。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. bench_update_records&lt;/div&gt;&lt;div&gt;专门测试已有记录的数值更新，每次将 value 加 1。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. bench_delete_records&lt;/div&gt;&lt;div&gt;专门测试按 ID 删除记录。&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="400" x="2080" y="895" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-20" parent="4w2NPqUuCC1P224UtZL3-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="191" width="381" x="2089.5" y="1084" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-22" parent="4w2NPqUuCC1P224UtZL3-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="220" width="273.81" x="2143.1" y="585" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-29" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-23" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;测试数据初始化&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;READ：预先生成 100 万条记录。&lt;/div&gt;&lt;div&gt;UPDATE：预先生成 100 万条记录。&lt;/div&gt;&lt;div&gt;DELETE：预先生成 100 万条记录。&lt;/div&gt;&lt;div&gt;INSERT：初始为空表。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;使用 PostgreSQL generate_series 批量生成测试数据。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;每轮测试前重置对应数据，保证测试能够重复执行。&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="2080" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-32" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-34" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-36" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-38" edge="1" parent="4w2NPqUuCC1P224UtZL3-1" source="4w2NPqUuCC1P224UtZL3-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="4w2NPqUuCC1P224UtZL3-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-26" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;四种数据库操作的测试方法&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;围绕四张独立的测试表，分别执行 READ、INSERT、UPDATE、DELETE。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;每个 RPC 请求对应一次数据库操作，通过传入记录 ID 和数据值完成读写。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;分别观察四种操作的执行效率、吞吐量和响应延迟。&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="430" x="2890" y="927.5" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-31" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;READ：读取已有记录&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;测试表：bench_read_records&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;初始准备 100 万条记录。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;客户端传入记录 ID，数据库根据主键查找对应记录，并返回 value。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;执行 SQL：&lt;/div&gt;&lt;div&gt;SELECT value FROM bench_read_records WHERE id = $1;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试目的：&lt;/div&gt;&lt;div&gt;观察数据库根据主键读取单条记录的性能。&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="420" x="3820" y="445" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-33" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;INSERT：新增记录&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;测试表：bench_insert_records&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;初始为空表。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;客户端传入新的记录 ID 和 value，将数据插入数据库。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;执行 SQL：&lt;/div&gt;&lt;div&gt;INSERT INTO bench_insert_records (id, value) VALUES ($1, $2);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试目的：&lt;/div&gt;&lt;div&gt;观察数据库新增记录的吞吐量和响应延迟。&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="420" x="3820" y="680" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-35" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;UPDATE：修改已有记录&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试表：bench_update_records&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;初始准备 100 万条记录。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;客户端传入记录 ID，找到对应记录，将 value 增加 1。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;执行 SQL：&lt;/div&gt;&lt;div&gt;UPDATE bench_update_records SET value = value + 1 WHERE id = $1;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试目的：&lt;/div&gt;&lt;div&gt;观察数据库定位记录、修改数据并完成写入的性能。&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="420" x="3820" y="999" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-37" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;DELETE：删除已有记录&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;测试表：bench_delete_records&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;初始准备 100 万条记录。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;客户端传入记录 ID，找到对应记录并删除。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;执行 SQL：&lt;/div&gt;&lt;div&gt;DELETE FROM bench_delete_records WHERE id = $1;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试目的：&lt;/div&gt;&lt;div&gt;观察数据库定位记录和删除数据的性能。&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="420" x="3820" y="1244" as="geometry" />
        </mxCell>
        <mxCell id="4w2NPqUuCC1P224UtZL3-39" parent="4w2NPqUuCC1P224UtZL3-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;&lt;b&gt;测试设计原则&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;四种操作分别使用独立的数据表，避免不同操作直接争用同一张测试表。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每个请求只执行一条 SQL，使用预处理语句传递参数。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每次写操作要求恰好影响一条记录，否则视为失败。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每轮测试前恢复对应表的数据，保证测试条件一致。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;四种操作分别统计 QPS、响应延迟和数据库调用耗时。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="156" width="370" x="2920" y="1084" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="KEnCTV_3UzhThJ9tz0uF" name="第一阶段代码设计：数据库访问架构与请求流转">
    <mxGraphModel dx="2239" dy="1013" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-1" parent="1" style="swimlane;html=1;startSize=70;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#000000;" value="第一阶段代码设计：数据库访问架构与请求流转&lt;div&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;一个 RPC &lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;请求是怎么从客户端进入服务端，最终执行 &lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;PostgreSQL &lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;SQL，再把结果返回给客户端的？&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="2580" width="3950" x="-420" y="50" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-7" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-9" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-11" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-2" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;第一阶段：数据库访问架构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;整个数据库访问层由三个核心组件组成：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DbConnection：负责 PostgreSQL 连接管理和 SQL 执行。&lt;/div&gt;&lt;div&gt;DbPool：负责 DB Worker 线程管理和数据库任务分配。&lt;/div&gt;&lt;div&gt;DbOperationAwaiter：负责 RPC 协程的挂起与恢复。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;三个组件相互配合，完成数据库请求的提交、执行、结果返回和协程恢复&lt;b&gt;。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="148" width="390" x="30" y="1132" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-13" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-6" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;DbConnection：数据库连接封装&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;每个 DbConnection 管理一条独立的 PostgreSQL 连接。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;连接建立后，提前准备 READ、INSERT、UPDATE、DELETE 四条 SQL。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;执行请求时，根据操作类型选择对应的预处理语句，通过 PQexecPrepared 执行并获取结果。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;当前使用同步 libpq 接口，执行期间会等待 PostgreSQL 返回结果。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="620" y="930" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-14" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-8" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;DbPool：数据库 Worker 线程池&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;创建固定数量的 DB Worker，每个 Worker 独占一个线程和一条 DbConnection。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;所有数据库任务进入公共任务队列，由空闲 Worker 取出执行。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;本阶段配置：&lt;/div&gt;&lt;div&gt;DB Worker = 16&lt;/div&gt;&lt;div&gt;PostgreSQL 连接 = 16&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;连接由 Worker 长期持有，不需要每次请求都重新建立或借出、归还。&lt;/div&gt;" vertex="1">
          <mxGeometry height="148" width="430" x="620" y="1132" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-15" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-10" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;DbOperationAwaiter：数据库协程等待器&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;通过 co_await 将数据库操作接入 RPC 协程。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;提交数据库任务后，挂起当前 RPC 协程，让 EventLoop 继续处理其他请求。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DB Worker 完成 SQL 后，将协程恢复任务投回原来的 EventLoop。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;协程恢复后，通过 await_resume 获取数据库执行结果。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="620" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-1" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-2" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PVHWKp8CHYdrlb9SHCFd-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-5" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-6" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-9" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-10" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-12" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;RPC 请求完整回路&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;客户端发起一次数据库 RPC 请求，经过服务端接收、协程调度、数据库任务提交和 SQL 执行，最终将数据库结果返回客户端。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通过完整请求链路，理解 DbConnection、DbPool 和 DbOperationAwaiter 三个组件是如何协同工作的。&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="1240" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-12" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-16" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;1. 客户端发起请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbBenchmarkRequest&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建数据库 RPC 请求对象&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;设置 operation / key / value&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;指定操作类型、记录 ID 和数据值&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcChannel 发起 RPC 调用&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将请求交给 NebulaRPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;通过 TCP 发送到服务端&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="430" x="1860" y="100" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-13" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="PVHWKp8CHYdrlb9SHCFd-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="PVHWKp8CHYdrlb9SHCFd-17" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;2. 服务端接收并转换请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RPC Server&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;接收并解析客户端 RPC 请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CoroutineService::Execute()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;进入数据库压测服务的协程处理函数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;GetContext&amp;lt;LoopDatabaseContext&amp;gt;()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;获取当前请求所属 EventLoop 的数据库上下文&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;AssertInOwnerLoop()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;确认当前代码运行在正确的 EventLoop 线程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ConvertRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;检查 operation / key / value 是否合法&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 Protobuf 请求转换成 DbRequest&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="430" x="1860" y="330" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-14" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="Y5IYW2_p-i5gXumpS4O9-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-3" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;3. 协程挂起并提交数据库任务&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await DbOperationAwaiter(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建数据库操作等待器&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_ready()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;返回 false，数据库操作不能立即完成&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_suspend(continuation)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存当前 RPC 协程的 continuation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;记录任务提交时间&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbPool::Submit(Job)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将数据库任务放入公共任务队列&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 RPC 协程挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop 可以继续处理其他网络请求&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="430" x="1860" y="670" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-15" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="Y5IYW2_p-i5gXumpS4O9-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-4" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;4. 数据库任务执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;WorkerMain()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Worker 线程进入任务循环&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;queue_ready_.wait()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;没有任务就睡眠等待&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;jobs_.pop_front()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从公共任务队列取出一个数据库任务&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;job(connection)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;把当前 Worker 独占的 DbConnection 交给任务执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbConnection::Execute()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;根据 operation 选择对应的预处理 SQL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQexecPrepared()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;同步阻塞等待 PostgreSQL 执行完成&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PostgreSQL 执行 SQL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;返回 PGresult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;解析数据库执行结果并生成 DbResult&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="430" x="1860" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-16" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="Y5IYW2_p-i5gXumpS4O9-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-7" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;5. 数据库结果返回并恢复协程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbResult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存数据库执行成功状态、返回值和错误信息&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;记录 database_call_us&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;统计 DbConnection::Execute() 的数据库调用耗时&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;计算 queue_wait_us&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;统计任务在 DB Worker 队列中的等待时间&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;loop_-&amp;gt;QueueInLoop()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将协程恢复任务投递回原来的 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;continuation.resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;恢复之前挂起的 RPC 协程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从 DbOperationAwaiter 中取回 DbResult&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="430" x="1860" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-17" edge="1" parent="PVHWKp8CHYdrlb9SHCFd-1" source="Y5IYW2_p-i5gXumpS4O9-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Y5IYW2_p-i5gXumpS4O9-18">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2790" y="1111" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-8" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;6. RPC 响应返回客户端&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbResult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;回到 CoroutineService::Execute()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response.set_success()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入数据库操作是否成功&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response.set_value()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入 READ 返回值或写操作影响行数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response.set_error()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入数据库错误信息&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response.set_database_call_us()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入数据库调用耗时&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;response.set_db_queue_wait_us()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入 DB Worker 排队耗时&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_return response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;NebulaRPC 将 Response 发回客户端&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;客户端收到响应并完成本次统计&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 Lane 继续提交下一条请求&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="410" width="430" x="1860" y="2040" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-18" parent="PVHWKp8CHYdrlb9SHCFd-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="226" width="984" x="2820" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="Y5IYW2_p-i5gXumpS4O9-19" parent="PVHWKp8CHYdrlb9SHCFd-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;第一阶段：高并发数据库测试结果&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;测试配置：&lt;/div&gt;&lt;div&gt;IO EventLoop = 4&lt;/div&gt;&lt;div&gt;DB Worker = 16&lt;/div&gt;&lt;div&gt;PostgreSQL Connection = 16&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Client Worker = 4&lt;/div&gt;&lt;div&gt;Window = 512&lt;/div&gt;&lt;div&gt;Total Inflight = 2048&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;关键观察：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. READ 吞吐量最高，达到约 4.48 万 QPS。&lt;/div&gt;&lt;div&gt;2. UPDATE 吞吐量约 1.79 万 QPS。&lt;/div&gt;&lt;div&gt;3. INSERT 和 DELETE 吞吐量约 0.9 万 QPS。&lt;/div&gt;&lt;div&gt;4. 写操作的平均延迟明显高于读取。&lt;/div&gt;&lt;div&gt;5. INSERT 出现明显长尾，P999 接近 952 ms。&lt;/div&gt;&lt;div&gt;6. DB Worker 队列等待时间占据了较大一部分请求总延迟。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;阶段性结论：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;PostgreSQL 已经完整接入现有 RPC 服务。&lt;/div&gt;&lt;div&gt;通过 16 个 DB Worker 和 16 条独立数据库连接，&lt;/div&gt;&lt;div&gt;实现了四种数据库操作的高并发访问。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;本阶段建立了数据库接入后的第一组真实性能基线，&lt;/div&gt;&lt;div&gt;同时发现数据库操作耗时和 DB Worker 排队&lt;/div&gt;&lt;div&gt;是影响整体请求延迟的重要因素。&lt;/div&gt;" vertex="1">
          <mxGeometry height="370" width="308" x="3158" y="1250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kBl0ZiNHKuUyZCrKpJJE" name="第二阶段设计：非阻塞数据库 IO 与 EventLoop 架构">
    <mxGraphModel dx="5006" dy="3252" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="500" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="et8CZAu-lRMyfvEnjKSG-1" parent="1" style="swimlane;html=1;startSize=70;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#000000;" value="第二阶段设计：非阻塞数据库 IO 与 EventLoop 架构&lt;div&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;font-weight: 400; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;如何将 PostgreSQL 连接交给 EventLoop 管理，通过非阻塞 libpq 发送 SQL、监听数据库 Socket，并在结果返回后恢复 RPC 协程？&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="4850" width="6700" x="-1931" y="-1420" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-2" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-3" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-4" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-35" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-37" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-41" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-5" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div&gt;&lt;b&gt;第二阶段：非阻塞数据库访问架构&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;移除 DB Worker 线程池，将 PostgreSQL 连接直接交给 IO EventLoop 管理。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;整个架构由三个核心组件组成：&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;LoopDatabaseContext：管理当前 EventLoop 的数据库连接和请求状态。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Channel：将 PostgreSQL Socket 接入 EventLoop。&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbOperationAwaiter：连接 RPC 协程与数据库操作，实现协程挂起和结果获取。&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="450" x="270" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-7" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;1. IO EventLoop 初始化&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::SetIoLoopInitCallback(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;注册 IO Loop 初始化回调&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RpcServer::Start(io_threads)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;启动 IO 工作线程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每个 IO 线程创建自己的 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;执行 IO Loop 初始化回调，传入当前 io_loop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;std::make_unique&amp;lt;LoopDatabaseContext&amp;gt;(io_loop, db_config)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建当前 EventLoop 对应的数据库上下文&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;io_loop-&amp;gt;SetContext(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将数据库上下文绑定到当前 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;每个 EventLoop 拥有独立的 LoopDatabaseContext&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="430" x="1300" y="370" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-9" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;2. LoopDatabaseContext 创建数据库连接&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;LoopDatabaseContext(loop, db_config)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存当前 EventLoop 和 PostgreSQL 连接配置&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;检查 EventLoop 是否有效，并确认当前线程归属&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ConnectAndPrepare()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;读取 DbConfig 中的 host / port / user / password / database&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQconnectdbParams()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;建立 PostgreSQL 连接，创建 PGconn 对象&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQstatus()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;检查数据库连接是否成功&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQsetClientEncoding(&quot;UTF8&quot;)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;设置客户端字符编码&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Prepare()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;在当前连接上提前准备四条 SQL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;READ / INSERT / UPDATE / DELETE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQsetnonblocking(connection_, 1)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;开启 PostgreSQL 连接的非阻塞模式&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;完成当前 EventLoop 的 PostgreSQL 连接初始化&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="446.5" width="430" x="1300" y="900" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-11" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;3. Channel 注册 PostgreSQL Socket 事件&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQsocket(connection_)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;获取当前 PostgreSQL 连接底层的 Socket fd&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;检查 Socket fd 是否有效&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;std::make_unique&amp;lt;Channel&amp;gt;(loop_, socket_fd)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;为 PostgreSQL Socket 创建 Channel&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;并绑定到当前 LoopDatabaseContext 所属的 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SetReadCallback(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;绑定可读事件回调 OnReadable()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SetWriteCallback(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;绑定可写事件回调 OnWritable()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SetCloseCallback(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;绑定连接关闭回调 OnSocketClosed()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SetErrorCallback(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;绑定 Socket 错误回调 OnSocketError()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;channel_-&amp;gt;EnableReading()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Channel 将 PostgreSQL Socket 的可读事件注册到当前 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop::UpdateChannel()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EPollPoller 将 PostgreSQL Socket 加入 epoll 监听&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PostgreSQL Socket 正式接入当前 IO EventLoop&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="472" width="430" x="1300" y="1488" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-33" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;本阶段架构配置：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;IO EventLoop = 4&lt;/div&gt;&lt;div&gt;PostgreSQL Connection = 4&lt;/div&gt;&lt;div&gt;DB Worker = 0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;每个 EventLoop 独占一条 PostgreSQL 连接。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;当前仍然采用单连接单 SQL 在途模式，尚未启用 Pipeline。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="350" y="2517.5" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-34" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;4. DbOperationAwaiter 提交数据库请求并挂起协程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CoroutineService::Execute()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;context.Loop()-&amp;gt;GetContext&amp;lt;LoopDatabaseContext&amp;gt;()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;获取当前 RPC 所属 EventLoop 的数据库上下文&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ConvertRequest(request)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 RPC 请求转换为 DbRequest&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_await DbOperationAwaiter(*database, db_request)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;创建 DbOperationAwaiter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存 LoopDatabaseContext、DbRequest 和 DbResult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_ready()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;始终返回 false&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 RPC 协程需要进入挂起流程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_suspend(continuation)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存当前 RPC 协程的 coroutine_handle&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;LoopDatabaseContext::Submit(request_, continuation, &amp;amp;result_)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;确认当前操作仍在所属 EventLoop 线程执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;构造 PendingRequest&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存 DbRequest、continuation、DbResult 地址和提交时间&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;pending_requests_.push_back(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将请求加入当前 EventLoop 的数据库等待队列&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;StartNextRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果数据库连接当前空闲，则尝试启动队首请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果已有 SQL 正在执行，则继续留在队列等待&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;await_suspend() 返回&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 RPC 协程保持挂起&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop 可以继续处理其他 RPC 和 Socket 事件&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="570" width="420" x="1310" y="2150" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-36" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;5. 非阻塞 PostgreSQL 数据库 IO&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;StartNextRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;从 pending_requests_ 取出队首请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;设置为当前 active_request_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;SendActiveRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;根据 DbOperation 选择对应的 Prepared Statement&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;READ / INSERT / UPDATE / DELETE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQsendQueryPrepared()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 SQL 请求写入 libpq 输出缓冲区&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;不等待 PostgreSQL 执行结果&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FlushOutput()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQflush(connection_)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;判断 libpq 输出缓冲区是否已经完全写入 Socket&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQflush() = 1&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前仍有数据未发送完成&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Channel::EnableWriting()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop 临时监听 PostgreSQL Socket 可写事件&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Socket 可写&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;OnWritable()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;再次执行 PQflush()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;直到输出缓冲区发送完成&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQflush() = 0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Channel::DisableWriting()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;停止监听可写事件&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;继续等待 PostgreSQL 返回数据&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PostgreSQL Socket 可读&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;OnReadable()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQconsumeInput()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 Socket 中已经到达的数据读取到 libpq 输入缓冲区&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;不阻塞等待新的网络数据&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;FlushOutput()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;再次确认是否还有未发送完成的数据&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ProcessResults()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQisBusy(connection_)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果仍为 Busy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;说明当前 SQL 结果尚未完整到达&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;继续等待下一次 Socket 可读事件&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQisBusy() = 0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQgetResult()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;取得当前 SQL 返回的 PGresult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;继续调用 PQgetResult()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;直到返回 nullptr&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;确认当前 SQL 的结果已经被完整读取&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 PostgreSQL 连接可以结束本次请求处理&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="940" width="430" x="1300" y="2870" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-40" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;div&gt;&lt;b&gt;6. 结果返回与 RPC 协程恢复&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ProcessResults()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PQgetResult()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;取得当前 SQL 返回的 PGresult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ParseResult(result, operation)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;根据数据库操作解析执行结果&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;READ：读取查询结果并解析 value&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;INSERT / UPDATE / DELETE：检查命令状态和影响行数&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;生成 DbResult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保存到 active_result_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;继续调用 PQgetResult()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;直到返回 nullptr&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;确认当前 SQL 的所有结果已经完整读取&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CompleteActive(DbResult)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;记录 database_call_us&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;保留当前请求的 queue_wait_us&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 DbResult 写入 DbOperationAwaiter 持有的 result_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;取出当前请求保存的 continuation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;清除 active_request_ 和 active_result_&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 PostgreSQL 连接重新变为空闲状态&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ResumeLater(continuation)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop::QueueInLoop(...)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将协程恢复任务重新加入所属 EventLoop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;避免直接在 PostgreSQL Channel 回调栈中恢复 RPC 业务协程&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;StartNextRequest()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;如果等待队列中还有数据库请求&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;立即开始下一条 SQL&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;EventLoop 执行 continuation.resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;原 RPC 协程从 co_await 位置继续执行&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DbOperationAwaiter::await_resume()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;返回 DbResult&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CoroutineService::Execute()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;将 success / value / error&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;database_call_us / db_queue_wait_us&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;写入 RPC Response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;co_return response&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;↓&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;当前 RPC 请求处理完成&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="800" width="430" x="1300" y="3880" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-42" parent="et8CZAu-lRMyfvEnjKSG-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="330" width="1595" x="3011" y="2260" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-43" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-44" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-45" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-46" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-47" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-48" edge="1" parent="et8CZAu-lRMyfvEnjKSG-1" source="et8CZAu-lRMyfvEnjKSG-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="et8CZAu-lRMyfvEnjKSG-42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="et8CZAu-lRMyfvEnjKSG-49" parent="et8CZAu-lRMyfvEnjKSG-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p&gt;第二阶段高并发测试&lt;/p&gt;&lt;p&gt;IO EventLoop = 4&lt;br&gt;PostgreSQL Connection = 4&lt;br&gt;DB Worker = 0&lt;/p&gt;&lt;p&gt;Client Worker = 4&lt;br&gt;Window = 512&lt;br&gt;Total Inflight = 2048&lt;br&gt;每组测试重复 3 次&lt;/p&gt;&lt;p&gt;第二阶段非阻塞数据库访问链路已经能够在高并发下稳定运行。&lt;/p&gt;&lt;p&gt;当前主要性能瓶颈并不在单次 PostgreSQL 执行，而在数据库请求排队。&lt;/p&gt;&lt;p&gt;由于每个 EventLoop 只有一条 PostgreSQL 连接，并且当前仍采用单连接单 SQL 在途模式，大量并发请求只能在 pending_requests_ 中等待。&lt;/p&gt;&lt;p&gt;这也为第三阶段引入 PostgreSQL Pipeline Mode 提供了明确依据：下一阶段需要降低单连接串行等待造成的队列延迟，并提高单连接的 SQL 在途能力。&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="689" x="3464" y="2670" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
